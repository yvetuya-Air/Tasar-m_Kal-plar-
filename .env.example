# Bu dosyayı .env adıyla kopyalayın. Gerçek anahtarları Git'e eklemeyin.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Google Books sunucu anahtarı. Anahtarsız erişim Google kotasına bağlı olarak reddedilebilir.
GOOGLE_BOOKS_API_KEY=
# Yerel HTTP için false; HTTPS sunucusunda true kullanın.
SESSION_COOKIE_SECURE=false
